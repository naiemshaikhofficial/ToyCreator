# ==============================================================================
# TOY CREATOR (creators.producertoy.com) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Authentication & Multi-Tenant Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site & Parent Storefront URLs
NEXT_PUBLIC_SITE_NAME=Toy Creator
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PARENT_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Bot Defense
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Prody AI Audio Copilot & Reasoning Engine (Groq)
PRODY_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# Google Ads API Keyword Planner Service (Optional / Server-Side Only)
# ------------------------------------------------------------------------------
# Used by Prody to retrieve verified monthly search volumes, advertiser competition,
# and top-of-page CPC bid ranges via GenerateKeywordIdeas (Google Ads API v18).
#
# If left blank, Prody automatically falls back to curated audio SEO domain intelligence
# without failing, throwing errors, or inventing fake search counts.
#
# Setup Steps:
# 1. Google Ads Manager Account -> Tools & Settings -> API Center -> Apply for Developer Token.
# 2. Google Cloud Console -> APIs & Services -> Enable 'Google Ads API'.
# 3. Create OAuth 2.0 Client (Web or Desktop) with scope: https://www.googleapis.com/auth/adwords
# 4. Generate long-lived Refresh Token via OAuth2 Playground or google-auth-library.
# 5. Insert your 10-digit Google Ads Customer ID (hyphens removed).
# ------------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional: Manager (MCC) Account ID if customer account is managed through an agency/MCC
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Resend Transactional Email Delivery (producertoy.com verified)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ProducerToy Creators <creators@producertoy.com>

# Google Drive Cloud Upload & Assets
GOOGLE_WEBHOOK_URL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Cloudflare Edge Worker & Asset Proxy
CLOUDFLARE_WORKER_URL=
PROXY_SECRET=
